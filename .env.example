# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Required for OpenAI official models (GPT-4o, GPT-4o-mini, o3-mini, o1).
# Configure in Vercel / Environment Variables (Settings -> Environment Variables -> OPENAI_API_KEY).
OPENAI_API_KEY=

# ANTHROPIC_API_KEY: Required for Anthropic Claude models (Claude 3.7 Sonnet, Claude 3.5 Sonnet, Claude 3.5 Haiku, Claude 3 Opus).
# Configure in Vercel / Environment Variables (Settings -> Environment Variables -> ANTHROPIC_API_KEY).
ANTHROPIC_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
